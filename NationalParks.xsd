<?xml version="1.0" encoding="UTF-8"?>
<!-- NationalParks.xsd : schema for CSE445 Assignment 4 (Figure 1 structure) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Root element: a directory of one or more national parks -->
  <xs:element name="NationalParks">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="NationalPark" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- One national park (declared globally so each park can still be validated even if the root is wrong) -->
  <xs:element name="NationalPark" type="NationalParkType"/>

  <!-- National park content: Name, one or more Phone, Address (left-to-right order) -->
  <xs:complexType name="NationalParkType">
    <xs:sequence>
      <xs:element name="Name"    type="xs:string"/>
      <xs:element name="Phone"   type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
      <xs:element name="Address" type="AddressType"/>
    </xs:sequence>
    <!-- Optional (implied) attribute -->
    <xs:attribute name="Rating" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <!-- Address: Number, Street, City, State, Zip (left-to-right order) -->
  <xs:complexType name="AddressType">
    <xs:sequence>
      <xs:element name="Number" type="xs:string"/>
      <xs:element name="Street" type="xs:string"/>
      <xs:element name="City"   type="xs:string"/>
      <xs:element name="State"  type="xs:string"/>
      <xs:element name="Zip"    type="xs:string"/>
    </xs:sequence>
    <!-- Required attribute -->
    <xs:attribute name="NearestAirport" type="xs:string" use="required"/>
  </xs:complexType>

</xs:schema>
